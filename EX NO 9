import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

public class StationarySystem extends JFrame {

    JCheckBox notebook, pen, pencil;
    JButton orderBtn;

    public StationarySystem() {
        setTitle("Stationary Purchase System");
        setSize(350, 250);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        // Layout
        setLayout(new GridLayout(5, 1));

        // Components
        notebook = new JCheckBox("Notebook @ 50");
        pen = new JCheckBox("Pen @ 30");
        pencil = new JCheckBox("Pencil @ 10");

        orderBtn = new JButton("Order");

        // Add components
        add(new JLabel("Stationary Purchase System", JLabel.CENTER));
        add(notebook);
        add(pen);
        add(pencil);
        add(orderBtn);

        // Button Action
        orderBtn.addActionListener(new ActionListener() {
            public void actionPerformed(ActionEvent e) {
                processOrder();
            }
        });

        setVisible(true);
    }

    private void processOrder() {
        int total = 0;
        String message = "";

        try {
            if (notebook.isSelected()) {
                int qty = getQuantity("Notebook");
                int cost = qty * 50;
                total += cost;
                message += "Notebook Quantity: " + qty + " Total: " + cost + "\n";
            }

            if (pen.isSelected()) {
                int qty = getQuantity("Pen");
                int cost = qty * 30;
                total += cost;
                message += "Pen Quantity: " + qty + " Total: " + cost + "\n";
            }

            if (pencil.isSelected()) {
                int qty = getQuantity("Pencil");
                int cost = qty * 10;
                total += cost;
                message += "Pencil Quantity: " + qty + " Total: " + cost + "\n";
            }

            if (message.equals("")) {
                JOptionPane.showMessageDialog(this, "Please select at least one item!");
                return;
            }

            message += "\nTotal: " + total;

            JOptionPane.showMessageDialog(this, message, "Message", JOptionPane.INFORMATION_MESSAGE);
            JOptionPane.showMessageDialog(this, "Successfully Ordered.", "Alert", JOptionPane.WARNING_MESSAGE);

        } catch (Exception ex) {
            JOptionPane.showMessageDialog(this, "Invalid input! Please enter numbers only.");
        }
    }

    private int getQuantity(String item) {
        String input = JOptionPane.showInputDialog("Enter Quantity for " + item + ":");
        return Integer.parseInt(input);
    }

    public static void main(String[] args) {
        new StationarySystem();
    }
}
