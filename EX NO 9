import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

public class Calc extends JFrame implements ActionListener {

    JTextField t = new JTextField();
    double n1, n2;
    char op;

    Calc() {
        setSize(250, 300);
        setLayout(new BorderLayout());

        add(t, BorderLayout.NORTH);

        JPanel p = new JPanel(new GridLayout(5,4));
        String b[] = {"7","8","9","/","4","5","6","*","1","2","3","-","0","C","=","+","%","√","x²","x³"};

        for(String x : b){
            JButton btn = new JButton(x);
            btn.addActionListener(this);
            p.add(btn);
        }

        add(p);
        setVisible(true);
    }

    public void actionPerformed(ActionEvent e){
        String c = e.getActionCommand();

        if(c.matches("[0-9]")) t.setText(t.getText()+c);

        else if(c.matches("[+\\-*/]")){
            n1 = Double.parseDouble(t.getText());
            op = c.charAt(0);
            t.setText("");
        }

        else if(c.equals("=")){
            n2 = Double.parseDouble(t.getText());
            switch(op){
                case '+': t.setText(""+(n1+n2)); break;
                case '-': t.setText(""+(n1-n2)); break;
                case '*': t.setText(""+(n1*n2)); break;
                case '/': t.setText(""+(n1/n2)); break;
            }
        }

        else if(c.equals("C")) t.setText("");

        else if(c.equals("%")) t.setText(""+(Double.parseDouble(t.getText())/100));
        else if(c.equals("√")) t.setText(""+Math.sqrt(Double.parseDouble(t.getText())));
        else if(c.equals("x²")) t.setText(""+Math.pow(Double.parseDouble(t.getText()),2));
        else if(c.equals("x³")) t.setText(""+Math.pow(Double.parseDouble(t.getText()),3));
    }

    public static void main(String[] args){
        new Calc();
    }
}
